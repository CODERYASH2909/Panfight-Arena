# Copy this file to `.env` and fill in real values before running the server.
# `python-environ` (django-environ) loads this automatically — see penfight/settings.py

# --- Core -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database -----------------------------------------------------------
# Set USE_SQLITE=True to skip Postgres entirely for a quick local trial run.
USE_SQLITE=False
DB_NAME=penfight_arena
DB_USER=penfight
DB_PASSWORD=penfight
DB_HOST=localhost
DB_PORT=5432

# --- Real-time (Channels) ------------------------------------------------
# Leave USE_REDIS_CHANNEL_LAYER=False for local single-process development
# (uses Django Channels' in-memory layer). Set True + provide REDIS_URL for
# anything beyond a single dev server (e.g. multiple workers/instances).
USE_REDIS_CHANNEL_LAYER=False
REDIS_URL=redis://127.0.0.1:6379/0

# --- CSRF (comma separated) ----------------------------------------------
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
