# Copy this to `.env` for local dev.
# For Railway/production, set these as environment variables in the Railway dashboard.

# ─── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated list — add your Railway domain + custom domain here
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Set DATABASE_URL to a Supabase connection string (recommended for prod)
#   Format: postgres://[user]:[password]@[host]:[port]/[dbname]
#   Get this from: Supabase Dashboard → Project → Settings → Database → Connection string
#   Use the "Transaction" pooler (port 6543) for multi-worker safety:
DATABASE_URL=

# Option B: Supply individual vars (used only if DATABASE_URL is not set)
USE_SQLITE=False
DB_NAME=penfight_arena
DB_USER=penfight
DB_PASSWORD=penfight
DB_HOST=localhost
DB_PORT=5432

# ─── Real-time (Django Channels / Redis) ─────────────────────────────────────
# Set USE_REDIS_CHANNEL_LAYER=True in production.
# On Railway, add a Redis service and it auto-injects REDIS_URL.
USE_REDIS_CHANNEL_LAYER=True
REDIS_URL=redis://127.0.0.1:6379/0

# ─── CSRF & trusted origins ──────────────────────────────────────────────────
# Add your Railway app domain + any custom domain (with https://)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─── Supabase Storage (optional — for avatar uploads via S3-compatible API) ──
# Leave blank to use local filesystem storage (MEDIA_ROOT).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=penfight-avatars

# ─── Django superuser (used only by railway_startup.sh on first deploy) ──────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-in-prod
